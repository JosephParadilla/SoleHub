@model IEnumerable<Product>

@{
    ViewData["Title"] = "Sneakers";
}

<section class="hero-section">
    <div class="hero-content">
        <p class="hero-eyebrow">NEW DROPS. ICONIC STYLE.</p>
        <h1>Step Into<br />Your Style.</h1>
        <p class="hero-description">
            Premium sneakers, running shoes, and slides for every step of your journey.
        </p>

        <a asp-controller="Product" asp-action="Index" class="btn btn-light hero-button">
            Shop Now
            <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="hero-shoe-text">
        SOLEHUB
    </div>
</section>

<section class="container-fluid px-4 mt-4">
    <div class="store-toolbar">
        <div>
            <h2 class="section-title">Featured Sneakers</h2>
            <p class="section-subtitle">
                Browse rubber shoes, running shoes, slides, and lifestyle sneakers.
            </p>
        </div>

        <form asp-controller="Product" asp-action="Index" method="get" class="search-form">
            <i class="bi bi-search search-icon"></i>

            <input type="text"
                   name="searchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control search-input"
                   placeholder="Search sneakers..." />

            <button type="submit" class="btn btn-dark search-button">
                Search
            </button>
        </form>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm">
            @TempData["Message"]
        </div>
    }

    <div class="category-pills mb-4">
        <a asp-controller="Product" asp-action="Index" class="category-pill">All</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="Running" class="category-pill">Running</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="Slides" class="category-pill">Slides</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="Lifestyle" class="category-pill">Lifestyle</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="Skate" class="category-pill">Skate</a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="product-card">

                    <a asp-controller="Product"
                       asp-action="Details"
                       asp-route-id="@item.Id"
                       class="product-image-box">
                        <img src="@item.ImageUrl" alt="@item.Name" class="product-image" asp-append-version="true" />
                    </a>

                    <div class="product-info">
                        <span class="product-brand">@item.Brand</span>

                        <h5 class="product-name">@item.Name</h5>

                        <p class="product-category">@item.Category</p>

                        <div class="rating-row">
                            <span class="stars">★★★★★</span>
                            <span class="rating-text">(4.5)</span>
                        </div>

                        <div class="product-bottom">
                            <strong class="product-price">₱@item.Price.ToString("N2")</strong>

                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-dark add-cart-btn">
                                Add to Cart
                               
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="container-fluid px-4 mt-5">
    <div class="store-benefits">
        <div class="benefit-item">
            <div class="benefit-icon">
                <i class="bi bi-truck"></i>
            </div>

            <div>
                <h5>Free Shipping</h5>
                <p>Free delivery for orders over ₱3,000.</p>
            </div>
        </div>

        <div class="benefit-item">
            <div class="benefit-icon">
                <i class="bi bi-cash-coin"></i>
            </div>

            <div>
                <h5>COD / GCash</h5>
                <p>Pay using Cash on Delivery, GCash, or card.</p>
            </div>
        </div>

        <div class="benefit-item">
            <div class="benefit-icon">
                <i class="bi bi-arrow-repeat"></i>
            </div>

            <div>
                <h5>Easy Returns</h5>
                <p>Request returns for wrong size or damaged items.</p>
            </div>
        </div>

        <div class="benefit-item">
            <div class="benefit-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>
                <h5>Trusted Store</h5>
                <p>Quality footwear from popular sneaker brands.</p>
            </div>
        </div>
    </div>
</section>

<section class="container-fluid px-4 mt-5">
    <div class="section-heading-row">
        <div>
            <h2 class="section-title">Shop by Category</h2>
            <p class="section-subtitle">
                Find the perfect pair based on your style and activity.
            </p>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Product" asp-action="Index" asp-route-category="Running" class="category-card category-running">
                <span>Running</span>
                <small>Lightweight shoes for daily runs.</small>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Product" asp-action="Index" asp-route-category="Slides" class="category-card category-slides">
                <span>Slides</span>
                <small>Comfortable footwear for casual use.</small>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Product" asp-action="Index" asp-route-category="Lifestyle" class="category-card category-lifestyle">
                <span>Lifestyle</span>
                <small>Everyday sneakers for clean outfits.</small>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Product" asp-action="Index" asp-route-category="Skate" class="category-card category-skate">
                <span>Skate</span>
                <small>Durable pairs for streetwear looks.</small>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<section class="container-fluid px-4 mt-5">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="promo-panel">
                <p class="hero-eyebrow">SOLEHUB STUDENT DEAL</p>

                <h2>Upgrade your rotation without breaking the budget.</h2>

                <p>
                    SoleHub helps students browse sneakers, compare prices, manage accounts,
                    checkout orders, and track purchase history in one simple MVC system.
                </p>

                <a asp-controller="Cart" asp-action="Index" class="btn btn-light hero-button">
                    View Cart
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="how-it-works-card">
                <h3>How SoleHub Works</h3>

                <div class="step-list">
                    <div class="step-item">
                        <div class="step-number">1</div>

                        <div>
                            <h5>Search Products</h5>
                            <p>Use the search bar to find shoes by name, brand, or category.</p>
                        </div>
                    </div>

                    <div class="step-item">
                        <div class="step-number">2</div>

                        <div>
                            <h5>Add to Cart</h5>
                            <p>Select your preferred sneaker and add it to your shopping cart.</p>
                        </div>
                    </div>

                    <div class="step-item">
                        <div class="step-number">3</div>

                        <div>
                            <h5>Checkout</h5>
                            <p>Enter your PH shipping address, courier, contact number, and payment method.</p>
                        </div>
                    </div>

                    <div class="step-item">
                        <div class="step-number">4</div>

                        <div>
                            <h5>Track Orders</h5>
                            <p>View completed orders and purchase details in Order History.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container-fluid px-4 mt-5 mb-5">
    <div class="section-heading-row">
        <div>
            <h2 class="section-title">Final Project Features</h2>
            <p class="section-subtitle">
                These sections match the required interaction and UI/UX features for SoleHub.
            </p>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-3 col-sm-6">
            <div class="project-feature-card">
                <i class="bi bi-search"></i>
                <h5>Search Bar</h5>
                <p>Search products by shoe name, brand, or category.</p>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="project-feature-card">
                <i class="bi bi-person-circle"></i>
                <h5>Account Management</h5>
                <p>Users can update profile information and upload a profile picture.</p>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="project-feature-card">
                <i class="bi bi-cart-check"></i>
                <h5>Cart and Checkout</h5>
                <p>Customers can add products to cart and complete checkout.</p>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="project-feature-card">
                <i class="bi bi-clock-history"></i>
                <h5>Order History</h5>
                <p>Customers and admin can view order records from the database.</p>
            </div>
        </div>
    </div>
</section>

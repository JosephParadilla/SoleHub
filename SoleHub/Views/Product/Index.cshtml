@model IEnumerable<SoleHub.Models.Product>

@{
    ViewData["Title"] = "Sneakers";
}

@Html.AntiForgeryToken()

<style>
    body {
        background-color: #050505;
        color: #ffffff;
    }

    .search-form {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50px;
        padding: 5px 5px 5px 20px;
        display: flex;
        align-items: center;
        backdrop-filter: blur(10px);
    }

    .search-input {
        background: transparent !important;
        border: none !important;
        color: white !important;
        box-shadow: none !important;
    }

        .search-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

    .store-benefits {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .benefit-item {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 2rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

        .benefit-item:hover {
            background: rgba(255, 255, 255, 0.06);
            transform: translateY(-5px);
            border-color: rgba(255, 255, 255, 0.2);
        }

    .benefit-icon {
        font-size: 1.8rem;
        color: #ffffff;
    }

    .custom-alert-dark {
        background: rgba(255, 255, 255, 0.05);
        border-left: 4px solid #4caf50;
        color: #fff;
        backdrop-filter: blur(10px);
        border-radius: 12px;
    }
</style>

<section class="hero-section">
    <div class="hero-content">
        <p class="hero-eyebrow">NEW DROPS. ICONIC STYLE.</p>
        <h1>Step Into<br />Your Style.</h1>
        <p class="hero-description">
            Premium sneakers, running shoes, and slides for every step of your journey.
        </p>

        <a asp-controller="Product" asp-action="Index" class="btn btn-light hero-button px-5 py-3 fw-bold rounded-pill">
            Shop Now
            <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>

    <div class="hero-shoe-text">
        SOLEHUB
    </div>
</section>

<section class="container-fluid px-4 mt-5">
    <div class="store-toolbar d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="mb-3 mb-md-0">
            <h2 class="section-title text-uppercase fw-bold mb-0">Featured Sneakers</h2>
        </div>

        <form asp-controller="Product" asp-action="Index" method="get" class="search-form" style="min-width: 320px;">
            <i class="bi bi-search text-white-50"></i>
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                   class="form-control search-input" placeholder="Search sneakers..." />
            <button type="submit" class="btn btn-light rounded-pill px-4 fw-bold">Search</button>
        </form>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert custom-alert-dark shadow-lg mb-4 p-3">
            <i class="bi bi-check2-circle me-2 text-success"></i> @TempData["Message"]
        </div>
    }

    <div class="category-pills mb-5">
        <a asp-controller="Product" asp-action="Index" class="category-pill">All</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="Running" class="category-pill">Running</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="Slides" class="category-pill">Slides</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="Lifestyle" class="category-pill">Lifestyle</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="Skate" class="category-pill">Skate</a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="product-card card-matte-black shadow-lg border-0">
                    <div class="product-image-box">
                        <button class="wishlist-btn-matte" data-product-id="@item.Id">
                            <i class="bi bi-heart"></i>
                        </button>

                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">
                            <img src="@item.ImageUrl" alt="@item.Name" class="product-image-floating" />
                        </a>
                    </div>

                    <div class="product-info p-4">
                        <span class="product-brand text-uppercase small text-white-50">@item.Brand</span>
                        <h5 class="product-name text-white fw-bold mb-1">@item.Name</h5>
                        <p class="product-category text-white-50 small">@item.Category</p>

                        <div class="rating-row mb-3">
                            <span class="stars text-warning">★★★★★</span>
                            <span class="rating-text text-white ms-1 small">4.5</span>
                        </div>

                        <div class="product-bottom d-flex align-items-center justify-content-between pt-2">
                            <span class="product-price fw-bold h5 mb-0 text-white">
                                ₱@item.Price.ToString("N2")
                            </span>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-light btn-solehub-sm px-4 py-2 fw-bold">
                                ADD TO CART
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="container-fluid px-4 mt-5 pt-5">
    <div class="store-benefits">
        <div class="benefit-item">
            <div class="benefit-icon"><i class="bi bi-truck"></i></div>
            <div>
                <h5 class="fw-bold mb-1">Free Shipping</h5>
                <p class="text-white-50 mb-0 small">On all orders above ₱3,000.</p>
            </div>
        </div>
        <div class="benefit-item">
            <div class="benefit-icon"><i class="bi bi-shield-check"></i></div>
            <div>
                <h5 class="fw-bold mb-1">Secure Payment</h5>
                <p class="text-white-50 mb-0 small">COD, GCash, or Credit Card.</p>
            </div>
        </div>
        <div class="benefit-item">
            <div class="benefit-icon"><i class="bi bi-arrow-repeat"></i></div>
            <div>
                <h5 class="fw-bold mb-1">Quick Returns</h5>
                <p class="text-white-50 mb-0 small">Easy 7-day return policy.</p>
            </div>
        </div>
    </div>
</section>

<section class="container-fluid px-4 mt-5">
    <div class="mb-4">
        <h2 class="fw-bold text-uppercase">Shop by Category</h2>
        <p class="text-white-50">Find the perfect pair for your lifestyle.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Product" asp-action="Index" asp-route-category="Running"
               class="category-card category-running">
                <span>Running</span>
                <small>Lightweight shoes for daily runs.</small>
                <i class="bi bi-arrow-right-circle h3 mb-0"></i>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Product" asp-action="Index" asp-route-category="Slides"
               class="category-card category-slides">
                <span>Slides</span>
                <small>Comfortable footwear for casual use.</small>
                <i class="bi bi-arrow-right-circle h3 mb-0"></i>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Product" asp-action="Index" asp-route-category="Lifestyle"
               class="category-card category-lifestyle">
                <span>Lifestyle</span>
                <small>Everyday sneakers for clean outfits.</small>
                <i class="bi bi-arrow-right-circle h3 mb-0"></i>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-controller="Product" asp-action="Index" asp-route-category="Skate"
               class="category-card category-skate">
                <span>Skate</span>
                <small>Durable pairs for streetwear looks.</small>
                <i class="bi bi-arrow-right-circle h3 mb-0"></i>
            </a>
        </div>
    </div>
</section>

<section class="container-fluid px-4 mt-5 pb-5">
    <div class="row g-4">
        <div class="col-lg-12">
            <div class="promo-panel p-5 rounded-5 shadow-lg"
                 style="background: linear-gradient(135deg, #111, #000); border: 1px solid rgba(255,255,255,0.05);">
                <p class="hero-eyebrow">SOLEHUB STUDENT DEAL</p>
                <h2 class="display-5 fw-bold mb-4">
                    Upgrade your rotation<br />without breaking the budget.
                </h2>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.wishlist-btn-matte').forEach(btn => {
            btn.addEventListener('click', async function () {
                const productId = this.dataset.productId;
                const icon = this.querySelector('i');

                try {
                    const response = await fetch('/Wishlist/Toggle?id=' + productId, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        if (data.isWishlisted) {
                            icon.classList.remove('bi-heart');
                            icon.classList.add('bi-heart-fill');
                            icon.style.color = '#ff4b2b';
                        } else {
                            icon.classList.remove('bi-heart-fill');
                            icon.classList.add('bi-heart');
                            icon.style.color = '';
                        }
                    } else {
                        window.location.href = '/Auth/Login';
                    }
                } catch (err) {
                    console.error('Wishlist error:', err);
                }
            });
        });
    </script>
}
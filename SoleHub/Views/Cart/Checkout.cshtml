@using Microsoft.AspNetCore.Http
@model List<SoleHub.Models.CartItem>

@{
    ViewData["Title"] = "Checkout";
    ViewData["HideTopBar"] = true;

    decimal subtotal = Model?.Sum(item => item.LineTotal) ?? 0;
    decimal shipping = subtotal >= 3000 ? 0 : 80;
    decimal total = subtotal + shipping;
}

<style>
    body {
        background-color: #050505;
        color: white;
    }

    .checkout-header {
        padding: 60px 0 30px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        margin-bottom: 40px;
    }

    .checkout-card-premium {
        background: #111;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 24px;
        padding: 40px;
    }

    .form-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        color: #888;
        margin-bottom: 10px;
    }

    .form-control, .form-select {
        background-color: #1a1a1a !important;
        border: 1px solid #222 !important;
        color: white !important;
        border-radius: 12px;
        padding: 12px 15px;
    }

        .form-control:focus, .form-select:focus {
            border-color: #444 !important;
            box-shadow: 0 0 0 0.25rem rgba(255, 255, 255, 0.05);
        }

    .checkout-item-row {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 15px;
        margin-bottom: 15px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .checkout-item-img {
        width: 60px;
        height: 60px;
        background: #1a1a1a;
        border-radius: 10px;
        object-fit: contain;
        padding: 5px;
    }

    .summary-sidebar {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 32px;
        padding: 30px;
        position: sticky;
        top: 30px;
    }

    .order-items-list::-webkit-scrollbar {
        width: 4px;
    }

    .order-items-list::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 10px;
    }

    .btn-confirm {
        background: white;
        color: black;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 15px;
        padding: 18px;
        transition: 0.3s;
        border: none;
    }

        .btn-confirm:hover:not(:disabled) {
            background: #e0e0e0;
            transform: translateY(-2px);
        }

        .btn-confirm:disabled {
            background: #444;
            color: #888;
            cursor: not-allowed;
        }
</style>

<div class="checkout-header">
    <div class="container">
        <h1 class="fw-black text-uppercase mb-0">Secure Checkout</h1>
        <p class="text-secondary small">Finalize your order and get your sneakers on the way.</p>
    </div>
</div>

<section class="container pb-5">
    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5">
            <h3 class="fw-bold">No items to checkout.</h3>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light rounded-pill px-5 mt-3">Back to Shop</a>
        </div>
    }
    else
    {
        <div class="row g-5">
            <div class="col-lg-7">
                <div class="checkout-card-premium">
                    <h4 class="fw-bold mb-4 border-bottom border-secondary border-opacity-25 pb-3">Shipping Details</h4>

                    <form id="checkoutForm" asp-controller="Cart" asp-action="ProcessPayment" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Full Name</label>
                                <input type="text" name="fullName"
                                       value="@(Context.Session.GetString("FullName") ?? "")"
                                       class="form-control" placeholder="Juan Dela Cruz" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Contact Number</label>
                                <input type="tel" name="contactNumber"
                                       value="@(Context.Session.GetString("ContactNumber") ?? "")"
                                       class="form-control" placeholder="09XXXXXXXXX"
                                       pattern="[0-9]{11}" title="Please enter 11-digit mobile number" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="email"
                                   value="@(Context.Session.GetString("Email") ?? "")"
                                   class="form-control" placeholder="customer@email.com" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Courier</label>
                                <select name="courier" class="form-select" required>
                                    <option value="">Select Courier</option>
                                    <option value="J&T Express">J&T Express</option>
                                    <option value="LBC Express">LBC Express</option>
                                    <option value="Flash Express">Flash Express</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Province</label>
                                <select id="province" name="province" class="form-select" required>
                                    <option value="">Select Province</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">City / Municipality</label>
                                <select id="city" name="city" class="form-select" required>
                                    <option value="">Select City / Municipality</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Barangay</label>
                                <select id="barangay" name="barangay" class="form-select" required>
                                    <option value="">Select Barangay</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Street Address / House No.</label>
                            <textarea name="streetAddress" class="form-control" rows="2"
                                  placeholder="House no., street, building..." required></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Payment Method</label>
                            <select name="paymentMethod" class="form-select" required>
                                <option value="Cash on Delivery">Cash on Delivery</option>
                                <option value="GCash">GCash</option>
                                <option value="Credit/Debit Card">Credit/Debit Card</option>
                            </select>
                        </div>

                        <button type="submit" id="btnSubmit" class="btn btn-confirm w-100 mt-2">
                            Confirm Purchase <i class="bi bi-lock-fill ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="summary-sidebar shadow-lg">
                    <h4 class="fw-bold mb-4">Your Order</h4>

                    <div class="order-items-list mb-4" style="max-height: 350px; overflow-y: auto;">
                        @foreach (var item in Model)
                        {
                            <div class="checkout-item-row">
                                <img src="@item.Product?.ImageUrl" class="checkout-item-img" alt="@item.Product?.Name" />
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-0 text-truncate" style="max-width: 180px;">@item.Product?.Name</h6>
                                    <small class="text-secondary">Size @item.Size x @item.Quantity</small>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold small">₱@item.LineTotal.ToString("N2")</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small fw-bold">SUBTOTAL</span>
                        <span class="fw-bold">₱@subtotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-secondary small fw-bold">SHIPPING</span>
                        <span class="@(shipping == 0 ? "text-success" : "") fw-bold">
                            @(shipping == 0 ? "FREE" : "₱" + shipping.ToString("N2"))
                        </span>
                    </div>

                    <hr class="border-secondary border-opacity-25 my-4">

                    <div class="d-flex justify-content-between align-items-end">
                        <h5 class="fw-black mb-0">TOTAL</h5>
                        <h3 class="fw-black mb-0 text-white">₱@total.ToString("N2")</h3>
                    </div>
                    <p class="text-secondary text-end small mt-1">Include VAT & Fees</p>
                </div>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const provinceSelect = document.getElementById('province');
            const citySelect = document.getElementById('city');
            const barangaySelect = document.getElementById('barangay');

            const loadProvinces = async () => {
                try {
                    const response = await fetch('https://psgc.gitlab.io/api/provinces/');
                    const provinces = await response.json();

                    provinces.push({
                        code: '130000000',
                        name: 'Metro Manila',
                        regionCode: '130000000'
                    });

                    provinces.sort((a, b) => a.name.localeCompare(b.name));

                    provinces.forEach(province => {
                        const option = document.createElement('option');
                        option.value = province.name;
                        option.dataset.code = province.code;
                        option.dataset.isRegion = province.code === '130000000';
                        option.textContent = province.name;
                        provinceSelect.appendChild(option);
                    });
                } catch (error) {
                    console.error('Error loading provinces:', error);
                }
            };

            loadProvinces();

            provinceSelect.addEventListener('change', function () {
                const selectedOption = this.options[this.selectedIndex];
                const code = selectedOption.dataset.code;
                const isRegion = selectedOption.dataset.isRegion === 'true';

                citySelect.innerHTML = '<option value="">Select City / Municipality</option>';
                barangaySelect.innerHTML = '<option value="">Select Barangay</option>';

                if (code) {
                    const url = isRegion
                        ? `https://psgc.gitlab.io/api/regions/${code}/cities-municipalities/`
                        : `https://psgc.gitlab.io/api/provinces/${code}/cities-municipalities/`;

                    fetch(url)
                        .then(response => response.json())
                        .then(data => {
                            data.sort((a, b) => a.name.localeCompare(b.name));
                            data.forEach(city => {
                                const option = document.createElement('option');
                                option.value = city.name;
                                option.dataset.code = city.code;
                                option.textContent = city.name;
                                citySelect.appendChild(option);
                            });
                        })
                        .catch(error => console.error('Error loading cities:', error));
                }
            });

            citySelect.addEventListener('change', function () {
                const selectedOption = this.options[this.selectedIndex];
                const cityCode = selectedOption.dataset.code;

                barangaySelect.innerHTML = '<option value="">Select Barangay</option>';

                if (cityCode) {
                    fetch(`https://psgc.gitlab.io/api/cities-municipalities/${cityCode}/barangays/`)
                        .then(response => response.json())
                        .then(data => {
                            data.sort((a, b) => a.name.localeCompare(b.name));
                            data.forEach(barangay => {
                                const option = document.createElement('option');
                                option.value = barangay.name;
                                option.textContent = barangay.name;
                                barangaySelect.appendChild(option);
                            });
                        })
                        .catch(error => console.error('Error loading barangays:', error));
                }
            });
        });
    </script>
}
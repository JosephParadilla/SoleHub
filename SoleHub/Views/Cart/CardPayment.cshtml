@{
    ViewData["Title"] = "Card Payment";
}

<section class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card shadow rounded-4 border-0">

                <div class="card-body p-4">

                    <h2 class="mb-4">
                        Debit / Credit Card
                    </h2>

                    <form asp-controller="Cart"
                          asp-action="CompleteCardOrder"
                          method="post">

                        <div class="mb-3">

                            <label class="form-label">
                                Card Holder Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Card Number
                            </label>

                            <input type="text"
                                   maxlength="16"
                                   class="form-control"
                                   placeholder="1234123412341234"
                                   required />

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Expiry Date
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="MM/YY"
                                       required />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    CVV
                                </label>

                                <input type="password"
                                       maxlength="3"
                                       class="form-control"
                                       required />

                            </div>

                        </div>

                        <button type="submit"
                                class="btn btn-dark w-100">

                            Pay Now

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>
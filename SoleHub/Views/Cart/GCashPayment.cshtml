@{
    ViewData["Title"] = "GCash Payment";
}

<section class="container py-5">

    <div class="text-center">

        <h1>GCash Payment</h1>

        <p>
            Scan the QR Code to complete your payment.
        </p>

        <img src="/images/gcash-qr.jpg"
             alt="GCash QR"
             style="max-width:300px;"
             class="img-fluid border rounded-4 shadow" />

        <div class="mt-4">

            <a asp-controller="Cart"
               asp-action="CompleteGCashOrder"
               class="btn btn-success btn-lg">

                I Already Paid

            </a>

        </div>

    </div>

</section>